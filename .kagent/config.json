{
  "ignoreGlobs": [
    "**/node_modules/**",
    "**/.git/**",
    ".git/**",
    "**/.kagent/**",
    ".kagent/**",
    "**/dist/**",
    "**/out/**",
    "node_modules/**",
    "build/**",
    "dist/**",
    "out/**",
    "test/**"
  ],
  "capture": {
    "onSave": true,
    "onEdit": true,
    "agentHook": true,
    "coalesceWindowMs": 1500
  }
}
